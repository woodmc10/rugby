FROM python:3.10-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    libgl1 \
    libglx-mesa0 \
    libglib2.0-0 \
    ffmpeg \
    git \
    vim \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip
RUN pip install --upgrade pip

# Install core data processing dependencies (no TensorFlow for now)
RUN pip install \
    opencv-python-headless==4.8.1.78 \
    "numpy>=1.21.0,<2.0.0" \
    pandas>=1.5.0 \
    Pillow>=9.0.0 \
    PyYAML>=6.0.0 \
    tqdm>=4.60.0 \
    matplotlib>=3.5.0 \
    seaborn>=0.11.0 \
    jupyter>=1.0.0 \
    jupyterlab>=3.0.0

# Set environment variables
ENV PYTHONPATH=/app
ENV TF_CPP_MIN_LOG_LEVEL=2

# Expose Jupyter port
EXPOSE 8888

CMD ["bash"]